# Docker Compose deployment environment. Copy this file to .env and replace every value.
POSTGRES_USER=herbalai
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=herbalai

JWT_SECRET=replace-with-a-cryptographically-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-cryptographically-random-secret

FRONTEND_URL=https://herbalai.ph
# Public browser URLs are embedded during the frontend image build. Rebuild after changing them.
NEXT_PUBLIC_API_URL=https://api.herbalai.ph/api
NEXT_PUBLIC_SOCKET_URL=https://api.herbalai.ph
GEMINI_API_KEY=replace-with-your-gemini-api-key
DR_AI_MAX_COSINE_DISTANCE=0.52
DR_AI_CHAT_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-2.5-flash-lite
DR_AI_MODEL_TIMEOUT_MS=7000
HERB_CACHE_TTL_MS=300000
SLOW_REQUEST_THRESHOLD_MS=1000
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=300000
DB_POOL_CONNECTION_TIMEOUT_MS=10000
DB_POOL_MAX_LIFETIME_SECONDS=1800
DB_POOL_METRICS_INTERVAL_MS=60000
AUTH_USER_CACHE_TTL_MS=5000
AUTH_USER_CACHE_MAX_ENTRIES=2000

# Production sends live mail. For local testing use "log", or use "allowlist"
# with comma-separated real test inboxes to prevent accidental audit emails.
EMAIL_DELIVERY_MODE=live
EMAIL_ALLOWED_RECIPIENTS=

# Required before running `npm run seed` in the backend container.
ADMIN_EMAIL=admin@herbalai.ph
ADMIN_PASSWORD=replace-with-a-unique-random-password-of-at-least-12-characters
