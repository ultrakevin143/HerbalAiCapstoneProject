# Docker Compose deployment environment. Copy this file to .env and replace every value.
POSTGRES_USER=herbalai
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=herbalai

JWT_SECRET=replace-with-a-cryptographically-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-cryptographically-random-secret

FRONTEND_URL=https://herbalai.ph
GEMINI_API_KEY=replace-with-your-gemini-api-key
